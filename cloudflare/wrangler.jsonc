{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "siperi-assistant-api",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-09",
  "workers_dev": true,
  "ai": { "binding": "AI" },
  "durable_objects": { "bindings": [{ "name": "DAILY_BUDGET", "class_name": "DailyBudget" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DailyBudget"] }],
  "ratelimits": [
    { "name": "PER_IP", "namespace_id": "202611091", "simple": { "limit": 5, "period": 60 } },
    { "name": "GLOBAL_RATE", "namespace_id": "202611092", "simple": { "limit": 20, "period": 60 } }
  ],
  "vars": {
    "ALLOWED_ORIGIN": "https://programdanpenganggaran-cmd.github.io",
    "AI_MODEL": "@cf/google/gemma-4-26b-a4b-it"
  }
}
